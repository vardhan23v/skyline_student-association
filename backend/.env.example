PORT=3000
NODE_ENV=development
# MySQL in production (Railway injects DATABASE_URL). Leave empty locally to use SQLite at ./dev.sqlite
DATABASE_URL=
JWT_SECRET=change-me-32-chars-minimum-please
QR_SECRET=change-me-too
PAYMENT_PROVIDER=razorpay
PAYMENT_WEBHOOK_SECRET=whsec_test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
EMAIL_FROM=ssa@example.com
RESEND_API_KEY=
CLOUDINARY_URL=
LLM_API_KEY=
APP_TIMEZONE=Asia/Kolkata
# Public origin of the site, no trailing slash. Email links are built from it and production 301s any other hostname
# to it (except /health, /api/health, /api/webhooks/*). Required in production. Defaults to http://localhost:$PORT.
APP_URL=
# Demo checkout: POST /api/payments/demo-confirm/:id marks a payment paid (same path as the webhook).
# Only works while RAZORPAY_KEY_ID/SECRET are empty. Never enable it on a site that takes real money.
DEMO_PAYMENTS=false
# Demo seed (database/seeds/001_demo.ts): `npm start` runs it on boot when true. In production the seed refuses to
# run without it. It WIPES the database, so it also skips a non-empty production DB unless SEED_FORCE=true (one boot).
ALLOW_DEMO_SEED=false
SEED_FORCE=false
