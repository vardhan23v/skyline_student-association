PORT=3000
NODE_ENV=development
# MySQL in production (Railway injects DATABASE_URL). Leave empty locally to use SQLite at ./dev.sqlite
DATABASE_URL=
JWT_SECRET=change-me-32-chars-minimum-please
QR_SECRET=change-me-too
PAYMENT_PROVIDER=razorpay
PAYMENT_WEBHOOK_SECRET=whsec_test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
EMAIL_FROM=ssa@example.com
RESEND_API_KEY=
CLOUDINARY_URL=
LLM_API_KEY=
SEED_DEMO=false
APP_TIMEZONE=Asia/Kolkata
# Only with SEED_DEMO=true: allow the seed to wipe a non-empty database
SEED_FORCE=false
