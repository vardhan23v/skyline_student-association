{
  "name": "ssa-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/scripts/migrate.ts latest",
    "migrate:rollback": "tsx src/scripts/migrate.ts rollback",
    "seed": "tsx src/scripts/migrate.ts seed",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed:if-enabled": "node -e \"if(process.env.SEED_DEMO==='true')require('child_process').execSync('npm run seed',{stdio:'inherit'})\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "mysql2": "^3.11.5",
    "node-cron": "^3.0.3",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.6",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "better-sqlite3": "^13.0.3",
    "supertest": "^7.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
